# dsh-web-relay — 托管块起点，块外内容原样保留。
# 本块由插件放在文件的最前面：Caddy 要求全局选项块是文件里的第一样东西，而块外的
# 站点（例如 apt 安装自带的 `:80` 静态站点）原样留在后面。
# 占位符由插件在引导时替换：
#   @@AUTHORITY@@       `vps.host:gateway.port`，浏览器地址栏里逐字出现的权威
#   @@HOST@@            权威里不带端口的主机名，给 `default_sni` 用
#   @@GATEWAY_PORT@@    `gateway.port`，与第一行里的端口相同
#   @@SESSION_SECRET@@  网关口令换来的会话密钥，来自记录的 `gateway.sessionSecret`
#   @@BCRYPT_HASH@@     `caddy hash-password` 的输出，来自 `gateway.password`
#   @@RELAY_PORT@@      `tunnel.relayPort`，默认 18080；必须与 ssh -R 参数一致
# BEGIN dsh-web-relay
{
	auto_https disable_redirects
	# 客户端对 IP 字面量不发 SNI；没有它时 Caddy 在裸 IP 访问下挑不到证书。
	default_sni @@HOST@@
	pki {
		ca dsh-relay {
			name "DSH Web Relay"
			intermediate_lifetime 8760h
		}
	}
}

# 上游只有一个，两个分支共用这一份定义：会话 Cookie 分支与口令分支必须给出
# 完全相同的响应，分开写时容易只改一处。
(dsh-relay-upstream) {
	# 浏览器第一次打开裸权威时还没有 DSH 会话 Cookie，上游必然回 401。把这种文档
	# 导航**在内部**改写成换票点，地址栏里就始终只有裸权威：换票点回一页 200 过渡页
	# 与 Set-Cookie（回 303 时 Safari 不保存 Cookie，会在 iOS 上无限跳转，见
	# `src/entry.ts` 的模块头），浏览器带着这份 Cookie 再取一次 `/` 就进了界面。
	#
	# 判据是 Accept：浏览器只在文档导航里发 text/html，`/api`、页面自己发起的资源
	# 请求与 WebSocket 握手都不带，它们各自的 401 必须原样透传。改写不看路径——
	# `/`、`/index.html` 与地址栏里手敲的任何路径都落在同一个换票点上。
	# `not` 而不是在值上写 `!`：Caddyfile 文档里 `!` 的用法是写在字段名上（字段
	# 不存在才匹配），值上的取反没有文档。
	#
	# 不需要 `route` 包一层：`rewrite` 在内置指令顺序表里排在 `reverse_proxy`
	# 之前，实测 caddy adapt 产出的处理器顺序就是 rewrite、reverse_proxy。
	@noDsh {
		method GET
		header Accept *text/html*
		not header Cookie *dsh-auth-*
	}
	rewrite @noDsh /relay/enter
	reverse_proxy 127.0.0.1:@@RELAY_PORT@@ {
		# DSH 自己不给 Cookie 加 Secure，由中继补上。这一行必须留在 reverse_proxy
		# 内：站点级 header 不延迟时不生效，延迟后又会改写下面那个 relay_session。
		# 按整个值匹配再追加，与 Cookie 的属性写法无关。
		header_down Set-Cookie "$" "; Secure"
		# Cookie 在、但已经失效（换过权威或换过签名密钥）时改写不会发生，上游回的 401
		# 落到这里：只有文档导航要送回去换票，`/api` 之类的 401 原样透传——那是客户端
		# 自己要处理的信号，变成一次跳转就成了"接口返回一张 HTML 页面"。
		#
		# 文档导航的判据只能写在块内：`handle_response` 自己的匹配器是**响应**匹配器，
		# 其中 `header` 看的是响应头，写在上面永远匹配不到请求的 `Accept`。
		@unauth status 401
		handle_response @unauth {
			@doc {
				method GET
				header Accept *text/html*
			}
			redir @doc /relay/enter 302
			copy_response
		}
		stream_timeout 24h
		stream_close_delay 5m
	}
}

# Host 与权威不匹配的请求会落到这里。没有这个兜底站点时 Caddy 返回 200 空响应，
# 浏览器上是一片无法归因的空白页。
:@@GATEWAY_PORT@@ {
	respond "dsh-web-relay: Host 与权威不匹配" 421
}

@@AUTHORITY@@ {
	# 操作者唯一需要打开的地址就是裸权威本身。DSH 只认带 token 的查询串或已有的
	# 会话 Cookie，所以第一次访问必然 401；上游片段里的 `@noDsh` 把这种文档导航
	# 在内部改写成 `/relay/enter`（这个路径字面量必须等于插件里的 `ENTER_PATH`，
	# `tests/caddyfile.test.js` 盯着这一条），地址栏里因此不会出现这条路径。
	# 上游透传的 401 是响应而不是 Caddy 自己产生的错误，`handle_errors` 接不到它，
	# 只有上游片段里的 `rewrite` 与 `handle_response` 能碰到。
	tls {
		issuer internal {
			ca dsh-relay
			lifetime 2160h
		}
	}

	handle_errors {
		@down `{err.status_code} == 502`
		handle @down {
			respond "dsh-web-relay: 无法连接内网主机（隧道未连接，或内网 dsh web 未响应）" 502
		}
	}

	@session header Cookie *relay_session=@@SESSION_SECRET@@*
	handle @session {
		import dsh-relay-upstream
	}

	handle {
		# route 按书写顺序执行；没有它时 header 会排在 basic_auth 之前，
		# 未认证的 401 响应也会带上 Set-Cookie，等于把会话密钥发给任何人。
		route {
			# 账号名是 HTTP Basic 的一部分，弹窗里那个输入框去不掉；Safari 与 Chrome
			# 又不再显示 realm（服务器可写的文字不该出现在受信任的 UI 里，实测 Safari
			# 的口令框只有主机名）。所以账号名没有可见的展示位，只出现在部署横幅、
			# 设置里的部署记录和文档中。
			basic_auth {
				@@GATEWAY_USER@@ @@BCRYPT_HASH@@
			}
			header Set-Cookie "relay_session=@@SESSION_SECRET@@; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=43200"
			import dsh-relay-upstream
		}
	}

	log {
		# 默认 100MiB×10 份对一台小盘中继太宽松：访问日志里每条 URI 都在，被刷时
		# 先吃掉磁盘再谈排查。上限压到 100MiB 以内。
		output file /var/log/caddy/dsh-relay-access.log {
			mode 0600
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			wrap json
			request>uri query {
				replace key REDACTED
				replace token REDACTED
			}
			request>headers>X-Forwarded-For delete
		}
	}
}
# END dsh-web-relay
