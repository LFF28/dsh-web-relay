{
  "name": "dsh-web-relay",
  "version": "0.1.0",
  "description": "把内网主机上的 dsh web 经一台公网中继交给远程设备：SSH 反向隧道、受限中继账号、网关口令与 DSH 权威注册",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "relay",
    "reverse-tunnel",
    "ssh-tunnel",
    "remote-access",
    "self-hosted",
    "caddy"
  ],
  "license": "MIT",
  "author": "LFF28 (https://github.com/LFF28)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LFF28/dsh-web-relay.git"
  },
  "homepage": "https://github.com/LFF28/dsh-web-relay#readme",
  "bugs": {
    "url": "https://github.com/LFF28/dsh-web-relay/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "deploy"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../ai/deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "link:../../ai/deepseek-harness/vendor/loader",
    "@deepseek-ai/dsh-client-connection": "link:../../ai/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../ai/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../ai/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../ai/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../ai/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../ai/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-home-paths": "link:../../ai/deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-host-webserver": "link:../../ai/deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-settings": "link:../../ai/deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-subprocess": "link:../../ai/deepseek-harness/packages/subprocess/subprocess",
    "@deepseek-ai/schemastery": "link:../../ai/deepseek-harness/vendor/schemastery",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
